# MemeAgotchi Server Environment Variables
# Copy to .env (never commit real secrets) or configure in Railway / Render / Fly.io

# Server HTTP port (defaults to 3000 in production, 3001 in dev)
PORT=3000

# Directory for SQLite database (memeagotchi.db) and uploaded meme images
# Mount a persistent volume here in cloud hosting!
DATA_DIR=./apps/server/data

# Strong random secret (>= 32 chars) used to HMAC-sign HttpOnly session cookies.
# If omitted, the server generates and persists DATA_DIR/.session-secret automatically.
SESSION_SECRET=replace-with-a-random-32-char-hex-secret

# Optional CORS allow-origin for cross-origin Capacitor Android or ESP32 web dev
# Example: https://memeagotchi.yourdomain.com
CORS_ORIGIN=
