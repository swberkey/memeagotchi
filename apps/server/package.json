{
  "name": "@memeagotchi/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    "./actions": {
      "types": "./src/actions.ts",
      "source": "./src/actions.ts",
      "default": "./dist/actions.js"
    }
  },
  "scripts": {
    "dev": "node --conditions=source --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:source": "node --conditions=source src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@memeagotchi/game-core": "1.0.0",
    "@memeagotchi/rpc-sdk": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10"
  }
}
